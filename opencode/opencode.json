{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permissions": [
    {
      "action": "shell",
      "resource": "go test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go vet *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "golangci-lint *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gofmt *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go fmt *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go build *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go doc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go mod *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go env *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "obsidian *",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "learn-go-with-tests": {
        "type": "remote",
        "url": "https://quii.gitbook.io/learn-go-with-tests/~gitbook/mcp",
        "disabled": false
      },
      "gopls": {
        "type": "local",
        "command": ["gopls", "mcp"],
        "disabled": false
      },
      "pkgsite": {
        "type": "local",
        "command": ["pkgsite"],
        "disabled": false
      }
    }
  }
}
