{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@franlol/opencode-md-table-formatter@0.0.6"],
  "instructions": ["learning-style.md"],
  "permission": {
    "bash": {
      "go test *": "allow",
      "go vet *": "allow",
      "golangci-lint *": "allow"
    },
    "external_directory": {
      "~/Projects/go-learning/**": "allow"
    }
  },
  "mcp": {
    "learn-go-with-tests": {
      "type": "remote",
      "url": "https://quii.gitbook.io/learn-go-with-tests/~gitbook/mcp",
      "enabled": true
    },
    "gopls": {
      "type": "local",
      "command": ["gopls", "mcp"],
      "enabled": true
    }
  }
}
