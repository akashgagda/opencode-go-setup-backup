{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "bash": {
      "go test *": "allow",
      "go vet *": "allow",
      "golangci-lint *": "allow",
      "gofmt *": "allow",
      "go fmt *": "allow",
      "go run *": "allow",
      "go build *": "allow",
      "go doc *": "allow",
      "go mod *": "allow",
      "go env *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "obsidian *": "allow"
    }
  },
  "mcp": {
    "learn-go-with-tests": {
      "type": "remote",
      "url": "https://quii.gitbook.io/learn-go-with-tests/~gitbook/mcp",
      "enabled": true
    },
    "gopls": {
      "type": "local",
      "command": ["gopls", "mcp"],
      "enabled": true
    },
    "pkgsite": {
      "type": "local",
      "command": ["pkgsite"],
      "enabled": true
    }
  }
}
